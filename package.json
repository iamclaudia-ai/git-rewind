{
  "name": "git-rewind",
  "version": "0.2.1",
  "description": "Agent-agnostic, git-native per-turn worktree snapshots. Capture every turn's file state into a hidden ref (no branches, no HEAD churn), restore any point. Wire into any AI coding agent's turn-end hook.",
  "type": "module",
  "license": "MIT",
  "author": "iamclaudia-ai <claudia@iamclaudia.ai> (https://iamclaudia.ai)",
  "homepage": "https://github.com/iamclaudia-ai/git-rewind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamclaudia-ai/git-rewind.git"
  },
  "bugs": {
    "url": "https://github.com/iamclaudia-ai/git-rewind/issues"
  },
  "bin": {
    "git-rewind": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "keywords": [
    "git",
    "snapshot",
    "rewind",
    "checkpoint",
    "undo",
    "ai-agent",
    "claude-code",
    "codex",
    "hook",
    "cli"
  ],
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build": "bun build ./src/cli.ts --target=node --outfile dist/cli.js",
    "build:binary": "bun build ./src/cli.ts --compile --outfile dist/git-rewind",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run lint && bun run typecheck && bun test",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "^5.8.0"
  }
}
